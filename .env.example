# .env.example — copy to .env.local and fill in your values
# Never commit .env.local

# Target application
BASE_URL=https://www.saucedemo.com

# Test credentials (saucedemo defaults)
TEST_USER_USERNAME=standard_user
TEST_USER_PASSWORD=secret_sauce

# Optional: Jira integration for jira-qa-runner agent
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=qa-bot@your-org.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=QA

# Optional: Slack alerts
# SLACK_WEBHOOK_URL=

# Optional: Lighthouse CI
# LHCI_GITHUB_APP_TOKEN=
