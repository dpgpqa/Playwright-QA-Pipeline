# =============================================================================
# Playwright QA Pipeline — Environment Configuration
# Copy to .env.local and fill in your values. Never commit .env.local
# =============================================================================

# --- Target Application URLs ---
# SauceDemo (E2E, Visual, Accessibility)
SAUCEDEMO_BASE_URL=https://www.saucedemo.com
SAUCEDEMO_USERNAME=standard_user
SAUCEDEMO_PASSWORD=secret_sauce

# Restful-Booker (API Testing)
RESTFUL_BOOKER_BASE_URL=https://restful-booker.herokuapp.com

# The Internet / Herokuapp (UI Components, Forms, Auth)
THE_INTERNET_BASE_URL=https://the-internet.herokuapp.com

# JSONPlaceholder (REST API)
JSONPLACEHOLDER_BASE_URL=https://jsonplaceholder.typicode.com

# DemoQA (UI Components, Forms, Widgets)
DEMOQA_BASE_URL=https://demoqa.com

# --- CI/CD Secrets (set in GitHub Actions secrets, not here) ---
# GITHUB_TOKEN=...
# SLACK_WEBHOOK_URL=...
# JIRA_API_TOKEN=...
# JIRA_BASE_URL=...
# JIRA_EMAIL=...
